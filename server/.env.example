# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is private: it is ignored by git and must never be shared.

# --- Server ---
PORT=3000
# "development" on your PC, "production" on the live server (enables secure cookies)
NODE_ENV=development

# --- MySQL (the database user created for the website, NOT root) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=arighna_pharma
DB_USER=arighna_app
DB_PASSWORD=

# --- Admin panel ---
# Address of the admin panel, e.g. http://localhost:3000/arighna-pharma
ADMIN_PATH=/arighna-pharma
# Long random text used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Uploads ---
# Folder where blog images and resumes are stored (relative to the server folder)
UPLOAD_DIR=uploads
